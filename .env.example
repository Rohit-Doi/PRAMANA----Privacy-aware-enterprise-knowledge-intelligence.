# PRAMĀṆA v2 — environment template.
# Do not fill this in by hand: run `python scripts/init_env.py`, which creates .env,
# generates every local secret, and copies your existing GOOGLE_API_KEY if it finds one.

# ── The only external credential that is required ──────────────────────────
GOOGLE_API_KEY=

# ── Optional extra LLM capacity (leave empty unless you hit quota) ──────────
GROQ_API_KEY=
CEREBRAS_API_KEY=

# ── Local secrets (generated) ──────────────────────────────────────────────
POSTGRES_PASSWORD=
NEO4J_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

# ── Local services (defaults match compose.yaml) ───────────────────────────
POSTGRES_DB=pramana
POSTGRES_USER=pramana
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
OPA_URL=http://127.0.0.1:8181

# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
